# Telegram: 不要提交真实 Token；由 BotFather 提供。
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# 允许工作的群 ID，逗号分隔；留空拒绝所有群的 AI 和上下文存储。
TELEGRAM_ALLOWED_CHAT_IDS=
# 数字用户 ID，逗号分隔；私聊 /start 可获得自己的 ID。
# 仅以下人员可管理机器人；Telegram 群管理员不会自动获得权限。
TELEGRAM_OWNER_IDS=
TELEGRAM_ADMIN_IDS=

# New API: 使用实际网关地址和可调用的模型 ID，不要填写上游展示名称。
NEW_API_BASE_URL=https://gateway.example.com/v1
NEW_API_KEY=replace-with-new-api-key
NEW_API_MODEL=replace-with-model-id
# 留空复用 NEW_API_MODEL。
DECISION_MODEL=

# 行为与上下文（按群隔离，论坛话题也隔离）
BOT_PERSONA=自然、友善、有幽默感的中文群聊伙伴
CONTEXT_MAX_MESSAGES=30
CONTEXT_MAX_CHARS=16000
MESSAGE_MAX_CHARS=2000
HISTORY_RETENTION_DAYS=7
DECISION_ENABLED=true
DECISION_CONFIDENCE_THRESHOLD=0.65
# 仅网关/模型支持 response_format=json_object 时开启。
DECISION_JSON_MODE=false

# 普通候选消息先概率采样，再调用决策模型；直接触发仍遵守硬限频。
REPLY_PROBABILITY=0.35
DIRECT_MENTION_ALWAYS_REPLY=true
MIN_REPLY_INTERVAL_SECONDS=20
CHAT_COOLDOWN_SECONDS=8
MAX_REPLIES_PER_HOUR=12
MESSAGE_BATCH_WINDOW_SECONDS=3
# 忽略积压超过此年龄的消息，避免重启后对陈旧群聊接话。
MESSAGE_MAX_AGE_SECONDS=300
REPLY_DELAY_MIN_SECONDS=1
REPLY_DELAY_MAX_SECONDS=3

# 时区用于群安静时段、每日预算和 /stats 的自然日统计。
BOT_TIMEZONE=Asia/Shanghai
# 同一用户、同一话题收到成功回复后，可免 @ 连续追问的秒数；0 关闭。
FOLLOWUP_TTL_SECONDS=120
# 每日请求尝试上限（含决策、回复、失败及重试）；0 禁用该范围的 AI 调用。
CHAT_DAILY_CALL_LIMIT=200
GLOBAL_DAILY_CALL_LIMIT=1000
USAGE_RETENTION_DAYS=30
# 每百万 Token 的美元单价；0 表示未配置估价，不代表免费。
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0
# 决策模型单价留空时不填写这两个变量，继承上面的单价。
# DECISION_INPUT_PRICE_PER_MILLION=0
# DECISION_OUTPUT_PRICE_PER_MILLION=0

# 应用重试次数；每次尝试独立计入预算，总调用仍受 AI_TIMEOUT_SECONDS 限制。
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=300
AI_MAX_CONCURRENT_REQUESTS=4
# 按网关/模型要求选择 max_tokens 或 max_completion_tokens。
AI_TOKEN_PARAMETER=max_tokens

# 本地开发路径；Compose 固定覆盖为 /app/data/bot.db。
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
# Compose 固定覆盖为 /tmp/bot-heartbeat；本地可改为 data/bot-heartbeat。
HEARTBEAT_PATH=/tmp/bot-heartbeat
HEALTHCHECK_MAX_AGE_SECONDS=180
