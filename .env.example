# =============================================================================
# Telegram AI 群聊伙伴 · 环境变量配置模板
# 复制本文件为 .env 后填写真实值：cp .env.example .env && chmod 600 .env
# 布尔值使用 true / false；ID 列表使用英文逗号分隔，不写群名称或用户名。
# 修改 .env 后必须重建容器（docker compose up -d --force-recreate）才能生效。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、Telegram 身份与权限
# -----------------------------------------------------------------------------

# 【必填】BotFather 创建的机器人 Token，格式形如 123456789:AAxxxx。
# 用于连接 Telegram Bot API 并接收/发送消息；泄露后请在 BotFather 用 /revoke 重置。
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# 【可选】允许工作的群数字 ID 列表，逗号分隔（如 -1001234567890,-1009876543210）。
# 群 ID 必须为负整数（论坛话题共享所属群 ID）。留空则拒绝所有群的 AI 与上下文存储。
# 不知道群 ID 时，把机器人加入群后由所有者/管理员发送 /chatid 获取。
TELEGRAM_ALLOWED_CHAT_IDS=

# 【可选】机器人所有者数字用户 ID 列表，逗号分隔，必须为正整数。
# 可查看 /stats global、执行全部管理命令；未知自身 ID 可私聊 /start 获取。
TELEGRAM_OWNER_IDS=

# 【可选】机器人管理员数字用户 ID 列表，逗号分隔，必须为正整数。
# 可执行群管理命令（/help、/chatid、/status、/pause、/resume、/context、/settings、
# /mode、/stats），但无 /stats global 权限；普通群管理员不会自动获得权限。
TELEGRAM_ADMIN_IDS=

# -----------------------------------------------------------------------------
# 二、AI 网关（New API / OpenAI 兼容）
# -----------------------------------------------------------------------------

# 【必填】AI 网关 Base URL，必须以 http(s) 开头，通常以 /v1 结尾。
# 不含用户名/密码/查询参数；实际路径以你的网关部署为准。
NEW_API_BASE_URL=https://gateway.example.com/v1

# 【必填】网关访问令牌（API Key）。
# 权限、额度与访问策略由网关侧控制；泄露后请在网关侧重置。
NEW_API_KEY=replace-with-new-api-key

# 【必填】用于生成回复的模型 ID，必须是在网关中实际可用的模型标识符。
# 不要填写网关界面展示名称，应使用接口所需的模型 ID 字符串。
NEW_API_MODEL=replace-with-model-id

# 【可选】仅用于发言判定的决策模型 ID。留空则复用 NEW_API_MODEL。
# 通常可设为更便宜的小模型以降低决策成本；未填写则不单独计费，继承通用单价。
DECISION_MODEL=

# -----------------------------------------------------------------------------
# 三、行为与上下文
# -----------------------------------------------------------------------------

# 机器人性格设定文本，会进入系统提示词；可包含空格，最长 4000 字符。
# 群内可用 /settings persona 覆盖当前群，不写则使用本默认值。
BOT_PERSONA=自然、友善、有幽默感的中文群聊伙伴

# 每群（论坛话题隔离）保留的最近消息条数，范围 1–200，默认 30。
# 包含用户与机器人消息，用于构造模型上下文；超出按滚动窗口丢弃最旧消息。
CONTEXT_MAX_MESSAGES=30

# 每群发送给模型的上下文字符预算上限，范围 500–100000，默认 16000。
# 控制上下文总体积，消息过多时截断较早内容以控制在预算内。
CONTEXT_MAX_CHARS=16000

# 单条输入内容（一条合并后的群消息）的字符上限，范围 100–10000，默认 2000。
# 超过此长度的消息将被忽略，不作为候选喂给模型。
MESSAGE_MAX_CHARS=2000

# 历史内容与去重标记的保留期限（天），范围 1–365，默认 7。
# 到期清理去重与历史记录；不影响最近 30 条聊天上下文的保留策略。
HISTORY_RETENTION_DAYS=7

# 是否启用 AI 第二级发言判定（决策模型）。true 开启 / false 关闭。
# 关闭后仍执行本地规则、随机采样与硬性限频，只是不再调用决策模型判断。
DECISION_ENABLED=true

# 决策模型判定“应回复”的最低置信度阈值，范围 0–1，默认 0.65。
# 仅当 action=reply 且模型自评 confidence 达到该值才生成回复；置信度为模型自评。
DECISION_CONFIDENCE_THRESHOLD=0.65

# 是否向网关发送 JSON 对象格式参数（response_format={"type":"json_object"}）。
# 仅当网关/决策模型确认支持时才设为 true；默认 false。无论是否开启都做本地严格校验。
DECISION_JSON_MODE=false

# -----------------------------------------------------------------------------
# 四、接话频率与限频（按群计算，论坛话题共享群配额）
# -----------------------------------------------------------------------------

# 普通候选消息在进入决策模型前按概率采样，范围 0–1，默认 0.35。
# 直接 @/回复触发不受此采样影响，但仍遵守冷却、间隔与配额等硬限频。
REPLY_PROBABILITY=0.35

# 直接 @机器人 或 回复机器人消息 时，是否跳过概率采样与 AI 决策直接回复。
# true 开启（仍受暂停、安静时段、冷却、间隔、配额、每日预算约束）。
DIRECT_MENTION_ALWAYS_REPLY=true

# 同一群两次 AI 回复之间的最短间隔（秒），范围 0–（无上限，含小数），默认 20。
# 防止刷屏；活跃模式默认 10 秒，可经 /settings 覆盖。
MIN_REPLY_INTERVAL_SECONDS=20

# 同一群两次模型处理尝试的冷却间隔（秒），范围 0–（含小数），默认 8。
# 即使本次被跳过或失败也计入冷却，避免高频重试。
CHAT_COOLDOWN_SECONDS=8

# 同一群滚动一小时内 AI 发送尝试上限（次），范围 1–3600，默认 12。
# 发送失败、Telegram 429 或网络结果不确定也消耗该配额，防崩溃后重复发言突破上限。
MAX_REPLIES_PER_HOUR=12

# 连续消息合并窗口（秒），范围 0–10，默认 3。
# 窗口内的多条消息会被合并为一条候选处理，避免拆分轰炸。
MESSAGE_BATCH_WINDOW_SECONDS=3

# 忽略超过该年龄（秒）的积压消息，范围 10–86400，默认 300。
# 避免进程重启后对陈旧群聊重新接话；窗口内的消息才会被处理。
MESSAGE_MAX_AGE_SECONDS=300

# 发言前随机等待区间下限（秒），范围 0–30，默认 1。
# 配合上限制造拟人化延迟；必须 ≤ REPLY_DELAY_MAX_SECONDS。
REPLY_DELAY_MIN_SECONDS=1

# 发言前随机等待区间上限（秒），范围 0–30，默认 3。
REPLY_DELAY_MAX_SECONDS=3

# -----------------------------------------------------------------------------
# 五、时区、连续追问与每日预算
# -----------------------------------------------------------------------------

# 群安静时段、自然日预算与 /stats 统计使用的 IANA 时区名，默认 Asia/Shanghai。
# 每日预算按此时区的自然日统计，跨午夜后开启新一天。
BOT_TIMEZONE=Asia/Shanghai

# 成功回复后，同一用户、同一群、同一话题可免 @ 连续追问的窗口（秒），范围 0–1800，默认 120。
# 设为 0 关闭免 @ 追问；安静模式下始终需要明确 @ 或回复。
FOLLOWUP_TTL_SECONDS=120

# 每个群每日网关请求尝试上限（含决策、回复、失败及重试），范围 0–100000，默认 200。
# 0 表示禁止该群所有模型调用；可由群内 /settings daily_call_limit 覆盖，全局上限仍生效。
CHAT_DAILY_CALL_LIMIT=200

# 全部群合计的每日网关请求尝试上限，范围 0–1000000，默认 1000。
# 0 表示禁止所有群的 AI 调用；每次请求须同时满足群上限与全局上限。
GLOBAL_DAILY_CALL_LIMIT=1000

# 调用及处理结果统计的独立保留天数，范围 1–365，默认 30。
# 不随最近 30 条聊天上下文一起清理；清理不删除当天用于预算判断的记录。
USAGE_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 六、计费单价（每百万 Token 的美元单价，仅用于 /stats 费用估算）
# -----------------------------------------------------------------------------

# 通用输入 Token 单价（美元/百万），范围 ≥0，默认 0。
# 0 表示未配置估价（不代表免费）；网关未返回完整用量或单价缺失时不计入费用合计。
AI_INPUT_PRICE_PER_MILLION=0

# 通用输出 Token 单价（美元/百万），范围 ≥0，默认 0。同上。
AI_OUTPUT_PRICE_PER_MILLION=0

# 决策模型输入 Token 单价（美元/百万）。留空则继承通用单价。
# 仅当为决策模型单独定价时填写；默认注释掉表示复用 AI_INPUT_PRICE_PER_MILLION。
# DECISION_INPUT_PRICE_PER_MILLION=0

# 决策模型输出 Token 单价（美元/百万）。留空则继承通用单价。同上。
# DECISION_OUTPUT_PRICE_PER_MILLION=0

# -----------------------------------------------------------------------------
# 七、模型调用与并发
# -----------------------------------------------------------------------------

# 单次模型调用总超时（秒，含重试），范围 0–300，默认 30。
# 超过则视为失败，不计入成功回复。
AI_TIMEOUT_SECONDS=30

# 应用额外重试次数（不含首次），范围 0–5，默认 2。
# 每次重试独立计入每日预算；总耗时仍受 AI_TIMEOUT_SECONDS 约束，SDK 自动重试已关闭。
AI_MAX_RETRIES=2

# 回复模型输出 Token 上限，范围 1–4000，默认 300。
# 控制单条回复长度，避免模型生成长文导致多条刷屏。
AI_MAX_OUTPUT_TOKENS=300

# 整个进程的模型调用并发上限，范围 1–32，默认 4。
# 控制同时发起的网关请求数，保护网关与本地资源。
AI_MAX_CONCURRENT_REQUESTS=4

# 发送给网关的 Token 数量参数名，可选 max_tokens 或 max_completion_tokens，默认 max_tokens。
# 网关/模型不支持 max_tokens 时改为 max_completion_tokens（如部分 o 系列模型）。
AI_TOKEN_PARAMETER=max_tokens

# -----------------------------------------------------------------------------
# 八、存储、日志与健康检查
# -----------------------------------------------------------------------------

# SQLite 数据库文件路径。本地默认 data/bot.db；Compose 固定覆盖为 /app/data/bot.db。
# 保存上下文、去重、暂停状态、群设置、限频与调用统计。
DATABASE_PATH=data/bot.db

# 日志级别，可选 DEBUG/INFO/WARNING/ERROR/CRITICAL，默认 INFO。
LOG_LEVEL=INFO

# 心跳文件路径。Compose 固定覆盖为 /tmp/bot-heartbeat（tmpfs 可写）；
# 本地开发应改回 data/bot-heartbeat（Windows 同样）。仅成功收到 getUpdates 时刷新。
HEARTBEAT_PATH=/tmp/bot-heartbeat

# 允许的心跳最大年龄（秒），范围 60–600，默认 180。
# 超过该时长未刷新心跳，容器健康检查判定为 unhealthy（不自动重启，需结合日志与监控）。
HEALTHCHECK_MAX_AGE_SECONDS=180
